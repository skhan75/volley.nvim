# Shared look for every recording (Sourced by the other tapes).
Set Shell "bash"
Set FontFamily "Hack Nerd Font"
Set FontSize 17
Set Width 1200
Set Height 700
Set Padding 18
Set Framerate 24
Set TypingSpeed 55ms
Set CursorBlink false
Set Theme { "name": "Blazer", "black": "#000000", "red": "#b87a7a", "green": "#7ab87a", "yellow": "#b8b87a", "blue": "#7a7ab8", "magenta": "#b87ab8", "cyan": "#7ab8b8", "white": "#d9d9d9", "brightBlack": "#4c4c4c", "brightRed": "#dbbdbd", "brightGreen": "#bddbbd", "brightYellow": "#dbdbbd", "brightBlue": "#bdbddb", "brightMagenta": "#dbbddb", "brightCyan": "#bddbdb", "brightWhite": "#ffffff", "background": "#0d1926", "foreground": "#d9e6f2", "selection": "#c1ddff", "cursor": "#d9e6f2" }
Env HOME "/tmp/volley-demo"
